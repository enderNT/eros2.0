# Anthropic
ANTHROPIC_API_KEY=sk-ant-dummy
ANTHROPIC_MODEL_CONVERSATION=claude-sonnet-5
ANTHROPIC_MODEL_CRISIS=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SUMMARIZATION=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_THINKING_TYPE=adaptive
ANTHROPIC_THINKING_DISPLAY=omitted
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_ITERATIONS=6

# Kapso (WhatsApp channel)
KAPSO_API_KEY=kapso-dummy
KAPSO_PHONE_NUMBER_ID=1087343774471931
KAPSO_WEBHOOK_SECRET=whsec-dummy
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0

# Calendly
CALENDLY_TOKEN=cal-dummy
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/REPLACE
CALENDLY_TIMEZONE=America/Mexico_City
CALENDLY_LOCATION_KIND=physical
# Clinic address, mentioned in the booking confirmation. Left empty, the
# confirmation simply omits it — never invent one.
CALENDLY_LOCATION_VALUE=
CALENDLY_SCHEDULING_LINK=
# Returned by Calendly when an operator registers the webhook subscription.
# Empty means /webhook/calendly rejects every delivery, which is the safe default.
CALENDLY_INVITEE_EMAIL=citas@example.com
CALENDLY_SIGNING_KEY=

# Storage (SQLite file on a persistent volume in production)
DB_PATH=./data/agente.db
CONTENT_DIR=./content

# Control panel
PANEL_PASSWORD=change-me
PANEL_SESSION_SECRET=change-me-to-a-random-string

# Behaviour
DEBOUNCE_SECONDS=4.0
WINDOW_TOKEN_BUDGET=2000
OVERLAP_TURNS=1
REPLY_MAX_CHUNKS=3
REPLY_CHUNK_CHARS=600
REPLY_CHUNK_DELAY_SECONDS=1.0
BOOKING_FOLLOWUP_MINUTES=90
BOOKING_FOLLOWUP_POLL_SECONDS=15.0
# Written by the clinic, never by us. Boot fails while this is a placeholder.
CRISIS_MESSAGE=<<pendiente: definir con la clínica>>

# Logging
LOG_LEVEL=INFO
